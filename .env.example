# Server-only settings. Copy to .env.local for local development and set the real values in the
# hosting provider's server environment. Never prefix them with NEXT_PUBLIC_ and never commit real
# values. Note: a .env.local that points at the real list makes `next dev`/`next start` write to it.

# Postgres connection string for the private access-request list (TLS, e.g. ?sslmode=require).
# The API answers 503 while this is empty.
DATABASE_URL=

# Random secret (32+ characters) for hashing client IPs in the rate limiter. Required; the API
# answers 503 without it.
APPLICATION_RATE_LIMIT_SECRET=

# Optional comma-separated exact origins allowed to submit besides https://nokka-web.vercel.app,
# e.g. a preview deployment. http://localhost:* is accepted automatically in `next dev`.
APPLICATION_ALLOWED_ORIGINS=

# --- Admin inbox (/admin/applications). Login and the admin API answer 503 until all are set. ---

# Random secret (32+ characters) that signs admin session cookies.
BETTER_AUTH_SECRET=

# This deployment's origin, used for the OAuth callback and the only allowed admin API Origin:
# http://localhost:3000 locally, https://nokka-web.vercel.app in production.
BETTER_AUTH_URL=

# GitHub OAuth App for this environment (callback: {BETTER_AUTH_URL}/api/auth/callback/github).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The admin's numeric GitHub user id (not the login name): gh api users/<login> --jq .id
ADMIN_GITHUB_USER_ID=

# --- Daily digest email (GET /api/cron/application-digest). Answers 503 until all are set. ---

# Random secret (16+ characters); Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Gmail API access of the sending account: OAuth client and refresh token (send-only use).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Sender (the connected Gmail address) and the one fixed recipient of the daily digest.
APPLICATION_DIGEST_FROM=
APPLICATION_DIGEST_TO=

# --- Registered app updates (/api/updates/v1/challenges, /registrations, /sessions). ---
# Code requests answer 503 until the secret, the GMAIL_* values above and the sender are set;
# registrations and sessions only need the database and the secret.

# Random secret (32+ characters) for one-time code and email HMACs and the API's IP rate limits.
# Changing it voids unused codes; registered Macs keep working.
UPDATE_REGISTRATION_SECRET=

# Sender of the registration code mail: the connected Gmail address (usually the same as
# APPLICATION_DIGEST_FROM). Codes go only to the stored email of a request the operator allowed.
UPDATE_CODE_MAIL_FROM=

# Optional. The origin the app signs into its proofs; defaults to https://nokka-web.vercel.app.
# Set it only for an isolated QA environment whose app build signs that environment's origin.
UPDATES_SIGNING_ORIGIN=

# Tests only: a disposable, direct (non-pooled) Postgres database. The integration tests create
# and drop their own schema; never use the production list.
APPLICATIONS_TEST_DATABASE_URL=
