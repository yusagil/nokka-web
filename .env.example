# Server-only settings for POST /api/applications. Copy to .env.local for local development and
# set the real values in the hosting provider's server environment. Never prefix them with
# NEXT_PUBLIC_ and never commit real values.

# Postgres connection string for the private access-request list (TLS, e.g. ?sslmode=require).
# The API answers 503 while this is empty.
DATABASE_URL=

# Random secret (32+ characters) for hashing client IPs in the rate limiter. Required; the API
# answers 503 without it.
APPLICATION_RATE_LIMIT_SECRET=

# Optional comma-separated exact origins allowed to submit besides https://nokka-web.vercel.app,
# e.g. a preview deployment. http://localhost:* is accepted automatically in `next dev`.
APPLICATION_ALLOWED_ORIGINS=

# Tests only: a disposable, direct (non-pooled) Postgres database. The integration tests create
# and drop their own schema; never use the production list.
APPLICATIONS_TEST_DATABASE_URL=
